# Copiez ce fichier en « .env » et adaptez les valeurs.
#
#   cp .env.example .env

# Mot de passe de l'espace chercheur et des exports CSV.
ADMIN_TOKEN=changez-moi

# URL du backend appelée par le navigateur des participants.
VITE_BACKEND_URL=http://localhost:5000

# Compte propriétaire de ./backend sur la machine hôte.
# Obtenez-les avec :  id -u   et   id -g
APP_UID=1000
APP_GID=1000
